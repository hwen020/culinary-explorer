FROM node:22-bookworm-slim AS frontend
WORKDIR /build
COPY package*.json ./
RUN npm ci
COPY frontend ./frontend
COPY index.html tsconfig.json vite.config.ts postcss.config.cjs tailwind.config.cjs ./
RUN npm run build

FROM python:3.12-slim
WORKDIR /service
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
COPY requirements-lock.txt ./
RUN pip install --no-cache-dir -c requirements-lock.txt fastapi uvicorn sqlalchemy pydantic python-dotenv httpx filelock
COPY backend ./backend
COPY --from=frontend /build/dist ./dist
USER 10001
CMD ["sh", "-c", "exec uvicorn backend.preview:app --host 0.0.0.0 --port ${PORT:-10000} --limit-concurrency 32 --no-proxy-headers"]
